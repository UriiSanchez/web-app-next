dist/

# Enviroments
.env
.env.local
.env.dev
.env.stage
.env.production

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml
test-report.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Next.js
.next/
*.orig
.vscode
.swc


#merge files problems
*_BACKUP_*.*
*_REMOTE_*.*
*_LOCAL_*.*
*_BASE_*.*

#Sonar
.scannerwork
sonarscan.js

#docker
*.tar

# Jest coverage
coverage

