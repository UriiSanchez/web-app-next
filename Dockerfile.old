# HISTORICAL REFERENCE ONLY: do not build this file.
# The supported pnpm build is Dockerfile (including its production-deps stage).
# Establish the base image in the construction stage
FROM node:22-alpine AS runner
WORKDIR /app

# Defines the construction arguments
ARG ARG_ACTIVE_ISILOANS=true

# Ajuste zona horaria
ENV TZ=Etc/GMT+6
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_SHARP_PATH=/tmp/node_modules/sharp

# Define environment variables with the value of the arguments
ENV NEXT_PUBLIC_ACTIVE_ISILOANS=${ARG_ACTIVE_ISILOANS}

# Create group and user for exec
RUN addgroup --system --gid 1001 group_easycredit
RUN adduser --system --uid 1001 user_easyfront

# Instalamos NewRelic para la imagen final aumenta solo 100 megas
RUN npm install newrelic --production --no-save && \
    npm cache clean --force && \
    rm -rf /app/node_modules/newrelic/examples \
    rm -rf /app/node_modules/newrelic/test \
    rm -rf /app/node_modules/newrelic/docs \
    rm -rf /app/node_modules/newrelic/NEWS.md \
    rm -rf /app/node_modules/newrelic/README.md

COPY  ./public ./public

# Copiamos la configuración de New Relic a la carpeta de ejecución
COPY ./newrelic.js ./newrelic.js

# Set the correct permission for prerender cache
RUN mkdir .next
RUN chown user_easyfront:group_easycredit .next
RUN touch newrelic_agent.log && chmod 666 newrelic_agent.log

# Automatically leverage output traces to reduce image size
COPY --chown=user_easyfront:group_easycredit ./.next/standalone ./
COPY --chown=user_easyfront:group_easycredit ./.next/static ./.next/static

USER user_easyfront

# The port on which the application will run is exposed.
EXPOSE 3001
ENV PORT=3001

# Server.js is created by next build from the standalone output
CMD ["node", "-r", "newrelic", "server.js"]
